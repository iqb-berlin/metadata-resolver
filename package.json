{
  "name": "@iqb/metadata-resolver",
  "version": "0.2.2",
  "description": "Framework-agnostic metadata and vocabulary resolver for IQB metadata profiles",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean && node -e \"require('node:fs').copyFileSync('dist/index.d.mts', 'dist/index.d.ts')\"",
    "dev": "tsdown src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build",
    "release": "npm publish"
  },
  "keywords": [
    "metadata",
    "vocabulary",
    "resolver",
    "iqb"
  ],
  "author": "IQB",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iqb/eslint-config": "^3.0.0",
    "@iqbspecs/metadata-profile": "^0.12.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.15.0",
    "prettier": "^3.8.1",
    "tsdown": "^0.20.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "eslint-plugin-sonarjs": {
      "minimatch": "^11.0.4"
    }
  },
  "peerDependencies": {
    "@iqbspecs/metadata-profile": "^0.11.1 || ^0.12.0"
  }
}
